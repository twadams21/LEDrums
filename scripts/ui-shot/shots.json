  "settings-controls": {
    "state": "view:trigger,settings:controls",
    "target": "dialog:Settings",
    "settle": 300
  },
  "settings-drums": {
    "state": "view:trigger,settings:drums",
    "target": "dialog:Settings",
    "settle": 300
  },
  "settings-outputs": {
    "state": "view:trigger,settings:outputs",
