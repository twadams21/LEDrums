  "effects-view": {
    "state": "view:trigger",
    "target": "main.center"
  },
  "visualizer": {
    "state": "view:trigger",
    "target": "aside.col2 .viz",
    "settle": 1500
  },
  "buses": {
    "state": "view:trigger",
    "target": "aside.col2 .buses"
  },
